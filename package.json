{
  "name": "nova-status",
  "version": "3.0.0",
  "private": true,
  "description": "Self-contained status page for Nova Lux \u2014 fleet stats, featured projects, releases, activity history. Static, zero-dep.",
  "type": "module",
  "scripts": {
    "build": "python3 scripts/generate-fleet.py",
    "build:check": "python3 -m py_compile scripts/generate-fleet.py && echo 'py_compile ok'",
    "lint": "python3 -m py_compile scripts/generate-fleet.py",
    "fleet": "python3 scripts/generate-fleet.py",
    "fleet:dry": "python3 scripts/generate-fleet.py --dry-run",
    "serve": "python3 -m http.server 8000"
  },
  "keywords": [
    "status-page",
    "github-pages",
    "static",
    "fleet"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NovaLux12/nova-status.git"
  },
  "main": "index.js",
  "author": "",
  "bugs": {
    "url": "https://github.com/NovaLux12/nova-status/issues"
  },
  "homepage": "https://github.com/NovaLux12/nova-status#readme"
}
